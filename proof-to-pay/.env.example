# ============================================================================
# Proof-to-Pay — Environment Variables Template
# Copy this file to `.env` and fill in your credentials.
# NEVER commit `.env` or expose PAYPAL_CLIENT_SECRET / AI keys to the browser.
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ----------------------------------------------------------------------------
# 1. PayPal Sandbox Credentials (Required for live Sandbox API execution)
# Create a free Sandbox REST API app at: https://developer.paypal.com/dashboard/applications/sandbox
# ----------------------------------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# PayPal Sandbox Business Account Email (Invoicer identity)
PAYPAL_INVOICER_EMAIL=sb-merchant@business.example.com
PAYPAL_INVOICER_GIVEN_NAME=Alex
PAYPAL_INVOICER_SURNAME=Rivera
PAYPAL_INVOICER_BUSINESS_NAME=Rivera Digital Studio

# PayPal Webhook ID (From PayPal Developer Dashboard -> App -> Webhooks)
# Used by POST /v1/notifications/verify-webhook-signature to cryptographically verify incoming events
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# ----------------------------------------------------------------------------
# 2. AI Model Credentials (Server-side structured scope extraction)
# Supports Google Gemini API or OpenAI API.
# If neither key is set locally, Proof-to-Pay transparently labels outputs as
# using the deterministic clause-grounded local extractor.
# ----------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI alternative
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
